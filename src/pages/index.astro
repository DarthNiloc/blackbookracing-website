---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Blackbook Racing Club — The thinking punter's racing club">
  <section class="hero">
    <p class="eyebrow">Every pick logged <span class="sep">·</span> Every result reconciled</p>
    <h1 class="brand-line">The thinking punter's racing club.</h1>
    <p class="substance">
      A small UK team of horse racing enthusiasts. Decades of UK racing data behind every selection.
      Hand-reviewed selections delivered each morning, logged before the off, reconciled after — and
      a curated blackbook of horses worth tracking.
    </p>
  </section>

  <figure class="hero-mark">
    <img src="/logo.png" alt="Blackbook Racing" loading="lazy" />
  </figure>

  <style>
    .hero {
      text-align: center;
      padding: 32px 0 24px;
    }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 28px;
    }

    .eyebrow .sep {
      margin: 0 6px;
      opacity: 0.7;
    }

    .brand-line {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      font-size: 44px;
      letter-spacing: 0.01em;
      line-height: 1.15;
      max-width: 720px;
      margin: 0 auto 32px;
    }

    .substance {
      font-family: 'EB Garamond', serif;
      font-size: 20px;
      line-height: 1.55;
      max-width: 600px;
      margin: 0 auto;
      color: var(--ink-soft);
    }

    .hero-mark {
      margin: 72px auto 0;
      max-width: 360px;
      text-align: center;
    }

    .hero-mark img {
      width: 100%;
      height: auto;
      display: block;
    }

    @media (max-width: 640px) {
      .hero {
        padding: 16px 0 8px;
      }

      .brand-line {
        font-size: 30px;
      }

      .substance {
        font-size: 17px;
      }

      .hero-mark {
        margin-top: 48px;
        max-width: 280px;
      }
    }
  </style>
</BaseLayout>
