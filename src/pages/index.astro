---
import BaseLayout from '../layouts/BaseLayout.astro';
import ledgerData from '../../public/ledger.json';

interface TierHead {
  n_picks: number;
  hit_rate_pct: number | null;
  roi_pct: number | null;
  total_profit_pts: number;
}

interface TierMini {
  // 'club' kept in the union transitionally: the public/ledger.json source
  // still emits the legacy 3-tier shape until Phase 3 publisher-move ships,
  // so we filter it out at render time rather than at the type level.
  key: 'free' | 'club' | 'blackbook';
  label: string;
  n_days: number;
  headline: TierHead;
  headline_30d: TierHead;
}

interface LedgerHead {
  first_date: string | null;
  last_date: string | null;
  window_30d_first: string | null;
  window_30d_last: string | null;
  tiers: TierMini[];
}

const ledger = ledgerData as LedgerHead;
const visibleTiers = ledger.tiers.filter(t => t.key !== 'club');

const POUND_PER_POINT = 10;

function fmtPct(n: number | null): string {
  if (n === null) return '—';
  return (n >= 0 ? '+' : '') + n.toFixed(1) + '%';
}

function fmtPts(n: number): string {
  return (n >= 0 ? '+' : '') + n.toFixed(1) + 'pt';
}

function fmtPound(pts: number): string {
  const pounds = Math.round(pts * POUND_PER_POINT);
  return (pounds >= 0 ? '+£' : '−£') + Math.abs(pounds).toLocaleString('en-GB');
}

function fmtDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  title="Blackbook Racing — Pre-off selections, public ledger, UK flat racing"
  description="UK flat racing selections — turf and all-weather. Published pre-off each morning, reconciled to Betfair SP. Public ledger. Hurdle add-on for Blackbook members."
>
  <figure class="hero-mark">
    <img src="/logo.png" alt="Blackbook Racing" />
  </figure>

  <section class="hero">
    <p class="eyebrow">Pre-off picks. Public ledger. UK flat racing.</p>
    <h1 class="brand-line">The thinking punter's edge.</h1>
    <p class="substance">
      Hand-reviewed selections published every morning of UK racing, logged before the off and
      reconciled to Betfair Starting Price after the race. Flat and all-weather are the focus;
      Blackbook members also get our hurdles add-on plus a curated list of horses worth tracking.
    </p>
  </section>

  <section class="numbers">
    <p class="numbers-eyebrow">Live ledger by tier <span class="eyebrow-sub">· last 30 days</span></p>
    <div class="tier-row">
      {visibleTiers.map(t => (
        <article class={"tier-stat tier-stat-" + t.key}>
          <p class="tier-stat-label">{t.label}</p>
          <span class={"tier-stat-roi " + ((t.headline_30d.roi_pct ?? 0) >= 0 ? "pos" : "neg")}>
            {fmtPct(t.headline_30d.roi_pct)}
          </span>
          <p class="tier-stat-roi-label">Return on stake</p>
          <div class="tier-stat-meta">
            <p class="meta-line">
              <span class="meta-num">{t.headline_30d.n_picks}</span>
              <span class="meta-lab">Selections</span>
            </p>
            <p class="meta-line">
              <span class="meta-num">{t.headline_30d.hit_rate_pct?.toFixed(1) ?? '—'}%</span>
              <span class="meta-lab">Strike rate</span>
            </p>
          </div>
          <p class={"tier-stat-pl " + (t.headline_30d.total_profit_pts >= 0 ? "pos" : "neg")}>
            {fmtPts(t.headline_30d.total_profit_pts)} <span class="pl-sub">P&amp;L</span>
          </p>
        </article>
      ))}
    </div>
    <div class="numbers-explainer">
      <p class="explainer-lead">
        <strong>ROI</strong> is profit per unit staked (each selection stakes 1pt).
      </p>
      <p class="explainer-lead">At £10 per point, P&amp;L totals are:</p>
      <ul class="explainer-list">
        {visibleTiers.map(t => (
          <li>
            <span class={t.headline_30d.total_profit_pts >= 0 ? 'pos pound' : 'neg pound'}>
              {fmtPound(t.headline_30d.total_profit_pts)}
            </span>
            <span class="explainer-tier">{t.label}</span>
          </li>
        ))}
      </ul>
    </div>
    <p class="numbers-period">
      Rolling 30 days to {ledger.window_30d_last && fmtDate(ledger.window_30d_last)}.
      <a href="/ledger">See the full all-time ledger →</a>
    </p>
  </section>

  <section class="essay">
    <p class="essay-eyebrow">Why we exist</p>
    <div class="essay-body">
      <p>
        Most racing tipsters publish their winners and stay quiet about the rest. We do the opposite.
        Every selection lands on the public ledger before the off, every result reconciles to Betfair
        Starting Price after the race, and every losing day sits on the page next to the wins.
      </p>
      <p>
        UK flat racing is the focus — turf and all-weather. Decades of UK racing data shaped the
        methodology, and every runner goes through the same gauntlet each morning. What clears the bar
        gets put on the slate. What doesn't, doesn't. Blackbook members also get our hurdles add-on
        plus a curated list of horses worth tracking through the season.
      </p>
      <p>
        The brief is narrow on purpose. We don't sell systems, pool money, or claim guaranteed returns.
        We tell you what we'd bet, log it before the off, and show you whether it worked. The rest is
        up to you.
      </p>
    </div>
  </section>

  <section class="values">
    <p class="values-eyebrow">What separates us</p>
    <div class="values-grid">
      <div class="value">
        <h3>Pre-off timestamps</h3>
        <p>
          Every selection is published the morning of the race — long before the off. The ledger
          records the timestamp, the price, and the stake. No retroactive edits, no "we said it the
          night before, trust us."
        </p>
      </div>
      <div class="value">
        <h3>Reconciled to BSP</h3>
        <p>
          Settlements use Betfair Starting Price — the same number a real punter would have got at the
          off. Commission is included in every profit figure. No house spreads, no fictional odds.
        </p>
      </div>
      <div class="value">
        <h3>Losers published</h3>
        <p>
          Bad days sit alongside good ones. The ledger breaks performance down by race code and
          signal, including the streams where we don't have an edge yet. The whole record is the
          proof, not the highlight reel.
        </p>
      </div>
    </div>
  </section>

  <section class="tiers-teaser">
    <p class="teaser-eyebrow">Pick your tier</p>
    <div class="tier-grid">
      <div class="teaser-card">
        <h3>Free</h3>
        <p class="teaser-price">£0</p>
        <p class="teaser-pitch">
          1 top-conviction selection each race day, posted in the public Telegram.
        </p>
      </div>
      <div class="teaser-card teaser-accent">
        <p class="teaser-flag">Full package</p>
        <h3>Blackbook</h3>
        <p class="teaser-price">£39.99<span class="period">/mo</span></p>
        <p class="teaser-pitch">
          The full top-conviction slate, plus value picks, form picks, hurdles, horses to track,
          drift alerts and weekly editorial.
        </p>
      </div>
    </div>
    <p class="teaser-cta">
      <a href="/subscribe">Compare tiers →</a>
    </p>
  </section>

  <style>
    .hero-mark {
      margin: 8px auto 28px;
      max-width: 280px;
      text-align: center;
    }

    .hero-mark img {
      width: 100%;
      height: auto;
      display: block;
    }

    .hero {
      text-align: center;
      padding: 0 0 24px;
    }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 22px;
    }

    .brand-line {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      font-size: 44px;
      letter-spacing: 0.01em;
      line-height: 1.15;
      max-width: 720px;
      margin: 0 auto 28px;
    }

    .substance {
      font-family: 'EB Garamond', serif;
      font-size: 20px;
      line-height: 1.55;
      max-width: 640px;
      margin: 0 auto;
      color: var(--ink-soft);
    }

    /* === Live ledger numbers band === */
    .numbers {
      max-width: 760px;
      margin: 96px auto 0;
      text-align: center;
      padding: 36px 32px;
      border-top: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }

    .numbers-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 20px;
    }

    .numbers-eyebrow .eyebrow-sub {
      color: var(--ink-mute);
      font-weight: 500;
      margin-left: 4px;
    }

    .tier-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      max-width: 520px;
      margin: 0 auto 22px;
    }

    .tier-stat {
      text-align: center;
      padding: 18px 14px 16px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--cream);
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-feature-settings: 'tnum';
    }

    .tier-stat-label {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 700;
    }

    .tier-stat-roi {
      font-family: 'Cormorant Garamond', serif;
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1;
    }

    .tier-stat-roi-label {
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 600;
      margin-top: -4px;
    }

    .tier-stat-meta {
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: center;
      padding: 4px 0;
    }

    .tier-stat-meta .meta-line {
      display: flex;
      flex-direction: column;
      gap: 2px;
      align-items: center;
    }

    .tier-stat-meta .meta-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      font-weight: 600;
      line-height: 1;
      color: var(--ink);
    }

    .tier-stat-meta .meta-lab {
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 600;
    }

    .tier-stat-pl {
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1;
      padding-top: 8px;
      border-top: 1px solid var(--rule);
    }

    .tier-stat-pl .pl-sub {
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 600;
      margin-left: 4px;
    }

    .numbers-explainer {
      max-width: 620px;
      margin: 22px auto 16px;
      text-align: center;
      font-feature-settings: 'tnum';
    }

    .explainer-lead {
      font-family: 'EB Garamond', serif;
      font-size: 14px;
      line-height: 1.55;
      color: var(--ink-soft);
      margin-bottom: 4px;
    }

    .explainer-lead strong {
      font-weight: 600;
      color: var(--ink);
      letter-spacing: 0.02em;
    }

    .explainer-list {
      list-style: none;
      padding: 0;
      margin: 10px 0 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
      align-items: center;
    }

    .explainer-list li {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
      line-height: 1.4;
      display: flex;
      align-items: baseline;
      gap: 12px;
      min-width: 220px;
      justify-content: space-between;
    }

    .explainer-list .pound {
      font-weight: 600;
      font-feature-settings: 'tnum';
    }

    .explainer-list .explainer-tier {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 700;
    }

    .pos { color: #2d5a2d; }
    .neg { color: #8b2a2a; }

    .numbers-period {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--ink-mute);
    }

    .numbers-period a {
      color: var(--ink);
      margin-left: 4px;
    }

    /* === Editorial / why we exist === */
    .essay {
      max-width: 640px;
      margin: 88px auto 0;
    }

    .essay-eyebrow,
    .values-eyebrow,
    .teaser-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      text-align: center;
      margin-bottom: 24px;
    }

    .essay-body p {
      font-family: 'EB Garamond', serif;
      font-size: 19px;
      line-height: 1.6;
      color: var(--ink);
      margin-bottom: 18px;
    }

    .essay-body p:last-child {
      margin-bottom: 0;
    }

    /* === Three value props === */
    .values {
      max-width: 980px;
      margin: 96px auto 0;
    }

    .values-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 36px;
    }

    .value h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.04em;
      margin-bottom: 12px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--rule);
    }

    .value p {
      font-family: 'EB Garamond', serif;
      font-size: 17px;
      line-height: 1.55;
      color: var(--ink-soft);
    }

    /* === Tier teaser === */
    .tiers-teaser {
      max-width: 980px;
      margin: 96px auto 0;
    }

    .tier-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      max-width: 640px;
      margin: 0 auto 28px;
    }

    .teaser-card {
      padding: 26px 24px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      text-align: center;
      background: var(--cream);
    }

    .teaser-accent {
      border-color: var(--gold);
      box-shadow: inset 0 0 0 1px var(--gold), 0 8px 24px -16px rgba(193, 164, 103, 0.45);
      background: linear-gradient(180deg, var(--cream) 0%, rgba(193, 164, 103, 0.08) 100%);
      position: relative;
    }

    .teaser-flag {
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--cream);
      background: var(--gold);
      padding: 4px 12px;
      border-radius: 3px;
      white-space: nowrap;
    }

    .teaser-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .teaser-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin-bottom: 12px;
      line-height: 1;
    }

    .teaser-price .period {
      font-size: 14px;
      color: var(--ink-mute);
      font-weight: 500;
      margin-left: 2px;
    }

    .teaser-pitch {
      font-family: 'EB Garamond', serif;
      font-size: 15px;
      line-height: 1.5;
      color: var(--ink-soft);
    }

    .teaser-cta {
      text-align: center;
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
    }

    .teaser-cta a {
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 4px;
    }

    .teaser-cta a:hover {
      border-bottom-width: 2px;
    }

    @media (max-width: 800px) {
      .values-grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .tier-grid {
        grid-template-columns: 1fr;
        gap: 14px;
        max-width: 420px;
        margin-left: auto;
        margin-right: auto;
      }

      .tier-row {
        grid-template-columns: 1fr;
        gap: 12px;
        max-width: 360px;
        margin-left: auto;
        margin-right: auto;
      }

      .tier-stat-roi {
        font-size: 28px;
      }
    }

    @media (max-width: 640px) {
      .hero {
        padding: 0 0 8px;
      }

      .brand-line {
        font-size: 30px;
      }

      .substance {
        font-size: 17px;
      }

      .eyebrow {
        font-size: 11px;
      }

      .hero-mark {
        margin: 4px auto 20px;
        max-width: 210px;
      }

      .numbers {
        margin-top: 64px;
        padding: 28px 18px;
      }

      .essay,
      .values,
      .tiers-teaser {
        margin-top: 64px;
      }

      .essay-body p {
        font-size: 17px;
      }
    }
  </style>
</BaseLayout>
