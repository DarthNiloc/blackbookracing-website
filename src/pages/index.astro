---
import BaseLayout from '../layouts/BaseLayout.astro';
import ledgerData from '../../public/ledger.json';

interface TierHead {
  n_picks: number;
  hit_rate_pct: number | null;
  roi_pct: number | null;
}

interface TierMini {
  key: 'open' | 'club' | 'blackbook';
  label: string;
  n_days: number;
  headline: TierHead;
}

interface LedgerHead {
  first_date: string | null;
  last_date: string | null;
  tiers: TierMini[];
}

const ledger = ledgerData as LedgerHead;

function fmtPct(n: number | null): string {
  if (n === null) return '—';
  return (n >= 0 ? '+' : '') + n.toFixed(1) + '%';
}

function fmtDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  title="Blackbook Racing Club — The thinking punter's racing club"
  description="A small UK team. Decades of racing data. Every pick logged before the off, every result reconciled to Betfair Starting Price. Data-driven UK racing picks with a public audit trail."
>
  <section class="hero">
    <p class="eyebrow">Every pick logged <span class="sep">·</span> Every result reconciled</p>
    <h1 class="brand-line">The thinking punter's racing club.</h1>
    <p class="substance">
      A small UK team of horse racing enthusiasts. Decades of UK racing data behind every selection.
      Hand-reviewed selections delivered each morning, logged before the off, reconciled after — and
      a curated blackbook of horses worth tracking.
    </p>
  </section>

  <figure class="hero-mark">
    <img src="/logo.png" alt="Blackbook Racing" loading="lazy" />
  </figure>

  <section class="numbers">
    <p class="numbers-eyebrow">Live ledger by tier</p>
    <div class="tier-row">
      {ledger.tiers.map(t => (
        <article class={"tier-stat tier-stat-" + t.key}>
          <p class="tier-stat-label">{t.label}</p>
          <span class={"tier-stat-roi " + ((t.headline.roi_pct ?? 0) >= 0 ? "pos" : "neg")}>
            {fmtPct(t.headline.roi_pct)}
          </span>
          <p class="tier-stat-meta">
            {t.headline.n_picks} picks <span class="dot">·</span> {t.headline.hit_rate_pct?.toFixed(1)}% hit
          </p>
        </article>
      ))}
    </div>
    <p class="numbers-period">
      {ledger.first_date && fmtDate(ledger.first_date)} — {ledger.last_date && fmtDate(ledger.last_date)}.
      <a href="/ledger">See the full ledger →</a>
    </p>
  </section>

  <section class="essay">
    <p class="essay-eyebrow">Why we exist</p>
    <div class="essay-body">
      <p>
        Most racing tipsters publish their winners and stay quiet about the rest. We do the opposite. Every
        selection lands on a public ledger before the off, every result reconciles to Betfair Starting Price
        after the race, and every losing month sits on the page next to the wins.
      </p>
      <p>
        We started because we wanted somewhere to bet that we'd actually trust ourselves. Decades of UK
        racing data went into the methodology long before any of it was published — and we still pull
        every runner through the same gauntlet each morning. What clears the bar gets put on the slate.
        What doesn't, doesn't.
      </p>
      <p>
        The brief is narrow on purpose. We don't sell systems. We don't pool money. We don't claim
        guaranteed returns. We tell you what we'd bet, log it before the off, and show you whether it
        worked. The rest is up to you.
      </p>
    </div>
  </section>

  <section class="values">
    <p class="values-eyebrow">What separates us</p>
    <div class="values-grid">
      <div class="value">
        <h3>Pre-off timestamps</h3>
        <p>
          Every selection is published before the race goes off. The ledger records the timestamp,
          the price, and the stake — no retroactive edits, no "we said it the night before, trust us."
        </p>
      </div>
      <div class="value">
        <h3>Reconciled to BSP</h3>
        <p>
          Settlements use Betfair Starting Price — the same number a real punter would have got at the
          off. Commission is included in every profit figure. No house spreads, no fictional odds.
        </p>
      </div>
      <div class="value">
        <h3>Losers published</h3>
        <p>
          Bad days sit alongside good ones. The ledger breaks performance down by race code, including
          the courses where we don't have an edge. The whole record is the proof, not the highlight reel.
        </p>
      </div>
    </div>
  </section>

  <section class="tiers-teaser">
    <p class="teaser-eyebrow">Three tiers, one ledger</p>
    <div class="tier-grid">
      <div class="teaser-card">
        <h3>Open</h3>
        <p class="teaser-price">Free</p>
        <p class="teaser-pitch">1–2 daily picks · next-morning results · in Telegram.</p>
      </div>
      <div class="teaser-card teaser-accent">
        <h3>Club</h3>
        <p class="teaser-price">£39<span class="period">/mo</span></p>
        <p class="teaser-pitch">Headline daily slate · pre-off Telegram · public ledger.</p>
      </div>
      <div class="teaser-card">
        <h3>Blackbook</h3>
        <p class="teaser-price">£99<span class="period">/mo</span></p>
        <p class="teaser-pitch">Fullest slate · horses to track · drift alerts · staking.</p>
      </div>
    </div>
    <p class="teaser-cta">
      <a href="/subscribe">Compare all tiers →</a>
    </p>
  </section>

  <style>
    .hero {
      text-align: center;
      padding: 32px 0 24px;
    }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 28px;
    }

    .eyebrow .sep {
      margin: 0 6px;
      opacity: 0.7;
    }

    .brand-line {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      font-size: 44px;
      letter-spacing: 0.01em;
      line-height: 1.15;
      max-width: 720px;
      margin: 0 auto 32px;
    }

    .substance {
      font-family: 'EB Garamond', serif;
      font-size: 20px;
      line-height: 1.55;
      max-width: 600px;
      margin: 0 auto;
      color: var(--ink-soft);
    }

    .hero-mark {
      margin: 72px auto 0;
      max-width: 360px;
      text-align: center;
    }

    .hero-mark img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* === Live ledger numbers band === */
    .numbers {
      max-width: 760px;
      margin: 96px auto 0;
      text-align: center;
      padding: 36px 32px;
      border-top: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
    }

    .numbers-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 20px;
    }

    .tier-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 22px;
    }

    .tier-stat {
      text-align: center;
      padding: 18px 14px 16px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--cream);
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-feature-settings: 'tnum';
    }

    .tier-stat-club {
      border-color: var(--gold);
    }

    .tier-stat-label {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 700;
    }

    .tier-stat-roi {
      font-family: 'Cormorant Garamond', serif;
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1;
    }

    .tier-stat-meta {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--ink-mute);
    }

    .tier-stat-meta .dot {
      color: var(--gold);
      margin: 0 4px;
    }

    .pos { color: #2d5a2d; }
    .neg { color: #8b2a2a; }

    .numbers-period {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--ink-mute);
    }

    .numbers-period a {
      color: var(--ink);
      margin-left: 4px;
    }

    /* === Editorial / why we exist === */
    .essay {
      max-width: 640px;
      margin: 88px auto 0;
    }

    .essay-eyebrow,
    .values-eyebrow,
    .teaser-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      text-align: center;
      margin-bottom: 24px;
    }

    .essay-body p {
      font-family: 'EB Garamond', serif;
      font-size: 19px;
      line-height: 1.6;
      color: var(--ink);
      margin-bottom: 18px;
    }

    .essay-body p:last-child {
      margin-bottom: 0;
    }

    /* === Three value props === */
    .values {
      max-width: 980px;
      margin: 96px auto 0;
    }

    .values-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 36px;
    }

    .value h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.04em;
      margin-bottom: 12px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--rule);
    }

    .value p {
      font-family: 'EB Garamond', serif;
      font-size: 17px;
      line-height: 1.55;
      color: var(--ink-soft);
    }

    /* === Tier teaser === */
    .tiers-teaser {
      max-width: 980px;
      margin: 96px auto 0;
    }

    .tier-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-bottom: 28px;
    }

    .teaser-card {
      padding: 26px 24px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      text-align: center;
      background: var(--cream);
    }

    .teaser-accent {
      border-color: var(--gold);
    }

    .teaser-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .teaser-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin-bottom: 12px;
      line-height: 1;
    }

    .teaser-price .period {
      font-size: 14px;
      color: var(--ink-mute);
      font-weight: 500;
      margin-left: 2px;
    }

    .teaser-pitch {
      font-family: 'EB Garamond', serif;
      font-size: 15px;
      line-height: 1.5;
      color: var(--ink-soft);
    }

    .teaser-cta {
      text-align: center;
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
    }

    .teaser-cta a {
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 4px;
    }

    .teaser-cta a:hover {
      border-bottom-width: 2px;
    }

    @media (max-width: 800px) {
      .values-grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .tier-grid {
        grid-template-columns: 1fr;
        gap: 14px;
        max-width: 420px;
        margin-left: auto;
        margin-right: auto;
      }

      .tier-row {
        grid-template-columns: 1fr;
        gap: 12px;
        max-width: 360px;
        margin-left: auto;
        margin-right: auto;
      }

      .tier-stat-roi {
        font-size: 28px;
      }
    }

    @media (max-width: 640px) {
      .hero {
        padding: 16px 0 8px;
      }

      .brand-line {
        font-size: 30px;
      }

      .substance {
        font-size: 17px;
      }

      .hero-mark {
        margin-top: 48px;
        max-width: 280px;
      }

      .numbers {
        margin-top: 64px;
        padding: 28px 18px;
      }

      .essay,
      .values,
      .tiers-teaser {
        margin-top: 64px;
      }

      .essay-body p {
        font-size: 17px;
      }
    }
  </style>
</BaseLayout>
