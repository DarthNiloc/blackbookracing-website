---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Tier {
  name: string;
  price: string;
  pricePeriod?: string;
  yearly?: string;
  pitch: string;
  bullets: string[];
  cta: { label: string; href?: string; disabled?: boolean };
  accent?: boolean;
}

const tiers: Tier[] = [
  {
    name: 'Free',
    price: '£0',
    pitch: 'One top-conviction selection each race day, in our public Telegram channel.',
    bullets: [
      '1 top-conviction selection each UK race day',
      'UK flat racing — turf and all-weather',
      'Public Telegram channel',
      'Free articles',
      'Full public ledger access',
    ],
    cta: { label: 'Join free on Telegram', href: 'https://t.me/BlackbookRacing' },
  },
  {
    name: 'Blackbook',
    price: '£39.99',
    pricePeriod: '/mo',
    yearly: 'or £359/yr · ~25% off',
    pitch: 'The full package — every signal we run, every code we cover, plus the seasonal blackbook of horses to track.',
    bullets: [
      'The complete top-conviction slate (multiple picks per race day)',
      'Value picks (market-edge model)',
      'Form picks (long-term form signals)',
      'UK flat, all-weather and hurdle racing',
      'The seasonal Blackbook of horses to track',
      'Pre-off drift alerts on every selection',
      'Recommended staking plans',
      'Members-only weekly editorial',
      'Pre-off timestamps, reconciled to Betfair SP',
      'Next-morning results in channel',
    ],
    cta: { label: 'Paid signup launches Q3 2026', disabled: true },
    accent: true,
  },
];
---

<BaseLayout
  title="Subscribe — Blackbook Racing"
  description="Free or Blackbook. Two tiers, one step. Join the free Telegram channel today, or sign up for Blackbook when paid signup opens."
>
  <article class="page">
    <p class="eyebrow">Subscribe</p>
    <h1 class="page-title">Free. Or Blackbook.</h1>
    <p class="lede">
      The Free tier is live in Telegram today — one top-conviction selection each race day.
      Blackbook is the full package: every signal, every code, every horse on the list. No
      middle tier, no upsell — one paid step.
    </p>

    <section class="tiers">
      {tiers.map(t => (
        <div class={"tier" + (t.accent ? " tier-accent" : "")}>
          <div class="tier-head">
            <h2 class="tier-name">{t.name}</h2>
            <div class="tier-price">
              <span class="amount">{t.price}</span>
              {t.pricePeriod && <span class="period">{t.pricePeriod}</span>}
            </div>
            {t.yearly && <p class="yearly">{t.yearly}</p>}
            <p class="pitch">{t.pitch}</p>
          </div>
          <ul class="bullets">
            {t.bullets.map(b => (
              <li><span class="mark">▲</span><span>{b}</span></li>
            ))}
          </ul>
          <div class="cta-wrap">
            {t.cta.disabled ? (
              <span class="cta cta-disabled" aria-disabled="true">{t.cta.label}</span>
            ) : (
              <a class="cta" href={t.cta.href} rel="noopener">{t.cta.label}</a>
            )}
          </div>
        </div>
      ))}
    </section>

    <section class="member-preview">
      <p class="preview-eyebrow">What you get</p>
      <h2 class="preview-title">A taste of each tier</h2>
      <div class="preview-grid">
        <div class="preview-card">
          <span class="preview-tier preview-tier-free">Free</span>
          <h3>The daily top pick</h3>
          <p class="preview-snip">▲ BLACKBOOK FREE <span class="bar">|</span> Today <span class="dot">·</span> 1 selection</p>
          <p class="preview-snip-small">17:25 LEICESTER · SKY SECRET</p>
          <p class="preview-snip-small quiet">Logged 08:14 BST · pre-off</p>
        </div>
        <div class="preview-card">
          <span class="preview-tier preview-tier-blackbook">Blackbook</span>
          <h3>The full package</h3>
          <p class="preview-snip">▲ BLACKBOOK <span class="bar">|</span> Today <span class="dot">·</span> 9 selections + 1 hurdle</p>
          <p class="preview-snip-small">+ value picks, form picks, hurdles</p>
          <p class="preview-snip-small">+ horses to track, drift alerts</p>
          <p class="preview-snip-small quiet">+ weekly editorial, team support</p>
        </div>
      </div>
      <p class="preview-cta">
        <a href="/members">See the full previews →</a>
      </p>
    </section>

    <section class="note-section">
      <h2>How it works</h2>
      <p>
        We sell information. You place your own bets at your own broker. We don't pool funds,
        accept stakes, manage money on your behalf, or operate as a syndicate. Selections post to
        Telegram pre-off and reconcile to Betfair Starting Price after the race.
      </p>
      <p>
        Cancel any time. No long-term contract, no minimum commitment beyond the current billing
        period. Members keep full ledger and editorial access for the period they've paid for.
      </p>
      <p>
        Past performance does not guarantee future returns. Betting carries the risk of losing
        money. UK racing is an 18+ activity; please bet responsibly. If gambling is affecting you
        or someone you know, contact <a href="https://www.begambleaware.org" rel="noopener" target="_blank">BeGambleAware</a>
        or call the National Gambling Helpline on 0808 8020 133.
      </p>
    </section>
  </article>

  <style>
    .page {
      padding-top: 16px;
    }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      text-align: center;
      margin-bottom: 12px;
    }

    .page-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 700;
      font-size: 40px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 24px;
    }

    .lede {
      font-family: 'EB Garamond', serif;
      font-size: 19px;
      line-height: 1.55;
      color: var(--ink-soft);
      max-width: 600px;
      margin: 0 auto 56px;
      text-align: center;
    }

    .tiers {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      max-width: 760px;
      margin: 0 auto 72px;
    }

    .tier {
      background: var(--cream);
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: 32px 28px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .tier-accent {
      border-color: var(--gold);
      box-shadow: inset 0 0 0 1px var(--gold);
    }

    .tier-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .tier-price {
      font-family: 'Cormorant Garamond', serif;
      display: flex;
      align-items: baseline;
      gap: 4px;
      margin-bottom: 6px;
    }

    .tier-price .amount {
      font-size: 42px;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .tier-price .period {
      font-size: 18px;
      color: var(--ink-mute);
      font-weight: 500;
    }

    .yearly {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-mute);
      margin-bottom: 14px;
    }

    .pitch {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
      line-height: 1.5;
      color: var(--ink);
    }

    .bullets {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .bullets li {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
      line-height: 1.45;
      display: flex;
      gap: 10px;
    }

    .bullets .mark {
      color: var(--gold);
      font-size: 11px;
      line-height: 1.6;
      flex-shrink: 0;
    }

    .cta-wrap {
      margin-top: auto;
      padding-top: 4px;
    }

    .cta {
      display: block;
      width: 100%;
      text-align: center;
      padding: 14px 18px;
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      background: var(--ink);
      color: var(--cream);
      text-decoration: none;
      border-radius: 4px;
    }

    .cta:hover {
      background: #1a1a1a;
    }

    .cta-disabled {
      background: transparent;
      color: var(--ink-mute);
      border: 1px solid var(--rule);
      cursor: default;
    }

    /* === Inline member-preview block === */
    .member-preview {
      max-width: 1080px;
      margin: 0 auto 64px;
      padding-top: 64px;
      border-top: 1px solid var(--rule);
      text-align: center;
    }

    .preview-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 12px;
    }

    .preview-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 700;
      font-size: 28px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 36px;
    }

    .preview-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      max-width: 760px;
      margin: 0 auto 28px;
      text-align: left;
    }

    .preview-card {
      padding: 22px 22px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--cream);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .preview-tier {
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      font-size: 10px;
      letter-spacing: 0.18em;
      padding: 3px 8px;
      border-radius: 3px;
      text-transform: uppercase;
      align-self: flex-start;
    }

    .preview-tier-free {
      background: var(--cream);
      color: var(--ink);
      border: 1px solid var(--rule);
    }

    .preview-tier-blackbook {
      background: var(--gold);
      color: var(--ink);
    }

    .preview-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.04em;
      margin-bottom: 4px;
    }

    .preview-snip {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.05em;
      color: var(--ink);
      font-feature-settings: 'tnum';
    }

    .preview-snip .bar {
      color: var(--ink-mute);
      margin: 0 4px;
    }

    .preview-snip .dot {
      color: var(--gold);
      margin: 0 4px;
    }

    .preview-snip-small {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      line-height: 1.5;
      color: var(--ink-soft);
      font-feature-settings: 'tnum';
    }

    .preview-snip-small.quiet {
      color: var(--ink-mute);
      font-style: italic;
    }

    .preview-cta {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
    }

    .preview-cta a {
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 4px;
    }

    .preview-cta a:hover {
      border-bottom-width: 2px;
    }

    .note-section {
      max-width: 680px;
      margin: 0 auto;
      padding-top: 48px;
      border-top: 1px solid var(--rule);
    }

    .note-section h2 {
      font-size: 18px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 18px;
      text-align: center;
    }

    .note-section p {
      font-family: 'EB Garamond', serif;
      font-size: 17px;
      line-height: 1.6;
      color: var(--ink-soft);
      margin-bottom: 14px;
    }

    .note-section a {
      color: var(--ink);
    }

    @media (max-width: 900px) {
      .tiers {
        grid-template-columns: 1fr;
        gap: 18px;
        max-width: 480px;
      }

      .preview-grid {
        grid-template-columns: 1fr;
        gap: 14px;
        max-width: 480px;
        margin-left: auto;
        margin-right: auto;
      }
    }

    @media (max-width: 640px) {
      .page-title {
        font-size: 28px;
      }

      .lede {
        font-size: 17px;
        margin-bottom: 40px;
      }

      .tier {
        padding: 28px 22px;
      }

      .tier-price .amount {
        font-size: 36px;
      }
    }
  </style>
</BaseLayout>
