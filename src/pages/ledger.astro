---
import BaseLayout from '../layouts/BaseLayout.astro';
import ledgerData from '../../public/ledger.json';

interface Pick {
  date: string;
  race_time: string;
  course: string;
  race_code: string;
  horse: string;
  stake_pts: number;
  bsp: number | null;
  result: 'win' | 'lose' | 'void';
  profit_pts: number;
  logged_at: string | null;
}

interface CourseRow {
  course: string;
  n_picks: number;
  n_wins: number;
  hit_rate_pct: number | null;
  total_stake_pts: number;
  total_profit_pts: number;
  roi_pct: number | null;
}

interface Summary {
  n_picks: number;
  n_wins: number;
  n_voided: number;
  hit_rate_pct: number | null;
  total_stake_pts: number;
  total_profit_pts: number;
  roi_pct: number | null;
}

interface StreamPackage extends Summary {
  name: 'flat' | 'all_weather' | 'hurdle';
  label: string;
  race_code: string;
  pitch: string;
  scope: string;
  first_date: string | null;
  last_date: string | null;
  n_days: number;
}

interface Ledger {
  generated_at: string;
  first_date: string | null;
  last_date: string | null;
  n_days: number;
  summary: Summary;
  stream_packages: StreamPackage[];
  by_course: CourseRow[];
  picks: Pick[];
}

const ledger = ledgerData as Ledger;

function fmtDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', timeZone: 'UTC' });
}

function fmtSign(n: number): string {
  return (n >= 0 ? '+' : '') + n.toFixed(2);
}

function fmtPct(n: number | null): string {
  if (n === null) return '—';
  return (n >= 0 ? '+' : '') + n.toFixed(1) + '%';
}

---

<BaseLayout
  title="Ledger — Blackbook Racing Club"
  description="The full public ledger. Every settled pick, every BSP, reconciled to Betfair after the race."
>
  <article class="page">
    <p class="eyebrow">Public ledger</p>
    <h1 class="page-title">The ledger.</h1>
    <p class="lede">
      Every settled pick from our highest-conviction streams. Timestamped pre-off. Settlements
      reconcile to Betfair Starting Price after the race. Losers published alongside winners.
    </p>

    <section class="package-band">
      <p class="package-band-eyebrow">Live performance by stream</p>
      <div class="package-grid">
        {ledger.stream_packages.map(p => (
          <div class={"package-card package-card-" + p.name}>
            <div class="package-head">
              <h2 class="package-label">{p.label}</h2>
              <span class="package-code">{p.race_code}</span>
            </div>
            <p class="package-pitch">{p.pitch}</p>
            <div class="package-stats">
              <div class="package-stat-roi">
                <span class={"package-stat-value " + ((p.roi_pct ?? 0) >= 0 ? "pos" : "neg")}>
                  {fmtPct(p.roi_pct)}
                </span>
                <span class="package-stat-label">ROI</span>
              </div>
              <div class="package-stat-row">
                <div class="package-stat-mini">
                  <span class="package-stat-mini-value">{p.n_picks}</span>
                  <span class="package-stat-mini-label">Picks</span>
                </div>
                <div class="package-stat-mini">
                  <span class="package-stat-mini-value">{p.hit_rate_pct?.toFixed(1)}%</span>
                  <span class="package-stat-mini-label">Hit rate</span>
                </div>
                <div class="package-stat-mini">
                  <span class="package-stat-mini-value">{p.n_days}</span>
                  <span class="package-stat-mini-label">Race days</span>
                </div>
              </div>
            </div>
            <p class="package-scope">{p.scope}</p>
          </div>
        ))}
      </div>
      <p class="period">
        {ledger.first_date && fmtDate(ledger.first_date)} <span class="dash">—</span>{' '}
        {ledger.last_date && fmtDate(ledger.last_date)} <span class="dot">▲</span> {ledger.n_days} race days
      </p>
    </section>

        <section class="block">
          <h2>By course</h2>
          <p class="block-note">
            Performance at every UK racecourse where we've placed at least three settled picks.
            Sorted by volume. Negative-ROI rows are visible because they should be — that's where
            we don't have an edge.
          </p>
          <table class="data-table course-table">
            <thead>
              <tr>
                <th>Course</th>
                <th class="num">Picks</th>
                <th class="num">Hit</th>
                <th class="num">ROI</th>
                <th class="num">P&amp;L</th>
              </tr>
            </thead>
            <tbody>
              {ledger.by_course.map(c => (
                <tr class={(c.roi_pct ?? 0) < 0 ? 'row-neg' : ''}>
                  <td class="course-name">{c.course}</td>
                  <td class="num">{c.n_picks}</td>
                  <td class="num">{c.hit_rate_pct?.toFixed(1)}%</td>
                  <td class={"num " + ((c.roi_pct ?? 0) >= 0 ? "pos" : "neg")}>{fmtPct(c.roi_pct)}</td>
                  <td class={"num " + (c.total_profit_pts >= 0 ? "pos" : "neg")}>{fmtSign(c.total_profit_pts)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section class="block">
          <h2>All picks</h2>
          <table class="data-table picks-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Off</th>
                <th>Course</th>
                <th>Horse</th>
                <th class="num">BSP</th>
                <th>Result</th>
                <th class="num">P&amp;L</th>
              </tr>
            </thead>
            <tbody>
              {ledger.picks.map(p => (
                <tr class={"row-" + p.result}>
                  <td>{fmtDate(p.date)}</td>
                  <td>{p.race_time}</td>
                  <td>{p.course}</td>
                  <td class="horse">{p.horse}</td>
                  <td class="num">{p.bsp !== null ? p.bsp.toFixed(2) : '—'}</td>
                  <td class={"result result-" + p.result}>{p.result}</td>
                  <td class={"num " + (p.profit_pts >= 0 ? "pos" : "neg")}>{fmtSign(p.profit_pts)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <p class="note">
          Stakes are 1pt unit; ROI is profit on stake. BSP is Betfair Starting Price; profit assumes 2% Betfair commission on winning bets.
        </p>
        <p class="note generated">
          Generated {ledger.generated_at}.
        </p>
  </article>

  <style>
    .page {
      padding-top: 16px;
    }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      text-align: center;
      margin-bottom: 12px;
    }

    .page-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 700;
      font-size: 40px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 24px;
    }

    .lede {
      font-family: 'EB Garamond', serif;
      font-size: 19px;
      line-height: 1.55;
      color: var(--ink-soft);
      max-width: 600px;
      margin: 0 auto 56px;
      text-align: center;
    }

    /* === Stream package band === */
    .package-band {
      max-width: 1080px;
      margin: 0 auto 56px;
    }

    .package-band-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      text-align: center;
      margin-bottom: 24px;
    }

    .package-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .package-card {
      padding: 28px 24px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--cream);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .package-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--rule);
    }

    .package-label {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0;
    }

    .package-code {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.22em;
      color: var(--gold);
      font-weight: 700;
    }

    .package-pitch {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
      line-height: 1.45;
      color: var(--ink-soft);
    }

    .package-stats {
      display: flex;
      flex-direction: column;
      gap: 16px;
      font-feature-settings: 'tnum';
    }

    .package-stat-roi {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--rule);
    }

    .package-stat-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 38px;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1;
    }

    .package-stat-label {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 600;
    }

    .package-stat-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .package-stat-mini {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .package-stat-mini-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1;
    }

    .package-stat-mini-label {
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 600;
    }

    .pos { color: #2d5a2d; }
    .neg { color: #8b2a2a; }

    .package-scope {
      font-family: 'EB Garamond', serif;
      font-size: 14px;
      font-style: italic;
      line-height: 1.5;
      color: var(--ink-mute);
      padding-top: 10px;
      border-top: 1px solid var(--rule);
      margin-top: auto;
    }

    .period {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.06em;
      color: var(--ink-mute);
      text-align: center;
      margin: 28px 0 4px;
      font-feature-settings: 'tnum';
    }

    .period .dash {
      margin: 0 6px;
    }

    .period .dot {
      color: var(--gold);
      margin: 0 8px;
    }

    .block {
      max-width: 920px;
      margin: 0 auto;
      padding-bottom: 36px;
    }

    .block + .block {
      padding-top: 36px;
      border-top: 1px solid var(--rule);
    }

    .block h2 {
      font-size: 20px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .block-note {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
      line-height: 1.55;
      color: var(--ink-soft);
      max-width: 720px;
      margin-bottom: 22px;
    }

    /* === Course table === */
    .course-table .course-name {
      font-family: 'EB Garamond', serif;
      font-size: 15px;
    }

    .row-neg .course-name {
      color: var(--ink-soft);
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-feature-settings: 'tnum';
    }

    .data-table th {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--ink-mute);
      text-align: left;
      padding: 10px 12px;
      border-bottom: 1px solid var(--ink);
    }

    .data-table th.num {
      text-align: right;
    }

    .data-table td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--rule);
      vertical-align: baseline;
    }

    .data-table td.num {
      text-align: right;
    }

    .data-table .code-name {
      color: var(--ink-mute);
      font-size: 12px;
      margin-left: 4px;
    }

    .picks-table .horse {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
    }

    .picks-table .result {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
    }

    .result-win  { color: #2d5a2d; }
    .result-lose { color: var(--ink-mute); }
    .result-void { color: var(--ink-mute); font-style: italic; }

    .row-lose td {
      color: var(--ink-soft);
    }
    .row-lose .horse {
      color: var(--ink);
    }

    .note {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--ink-mute);
      text-align: center;
      max-width: 600px;
      margin: 16px auto 0;
      line-height: 1.55;
    }

    .note.generated {
      margin-top: 8px;
      opacity: 0.7;
      font-feature-settings: 'tnum';
    }

    @media (max-width: 920px) {
      .package-grid {
        grid-template-columns: 1fr;
        gap: 14px;
        max-width: 480px;
        margin: 0 auto;
      }
    }

    @media (max-width: 720px) {
      .page-title {
        font-size: 28px;
      }

      .lede {
        font-size: 17px;
        margin-bottom: 40px;
      }

      .package-card {
        padding: 24px 22px;
      }

      .package-stat-value {
        font-size: 32px;
      }

      .package-stat-mini-value {
        font-size: 18px;
      }

      .data-table {
        font-size: 12px;
      }

      .data-table th,
      .data-table td {
        padding: 8px 6px;
      }

      .picks-table .horse {
        font-size: 14px;
      }
    }
  </style>
</BaseLayout>
