---
import BaseLayout from '../layouts/BaseLayout.astro';
import ledgerData from '../../public/ledger.json';

interface Summary {
  n_picks: number;
  n_wins: number;
  n_voided: number;
  hit_rate_pct: number | null;
  total_stake_pts: number;
  total_profit_pts: number;
  roi_pct: number | null;
}

interface BankRow extends Summary {
  bank_key: string;
  bank_label: string;
}

interface CodeBlock {
  race_code: string;
  label: string;
  total: Summary;
  banks: BankRow[];
}

interface Pick {
  date: string;
  race_time: string;
  course: string;
  race_code: string;
  horse: string;
  stake_pts: number;
  bsp: number | null;
  result: 'win' | 'lose' | 'void';
  profit_pts: number;
  logged_at: string | null;
}

interface Tier {
  // 'club' kept in the union transitionally: public/ledger.json still emits
  // the legacy 3-tier shape until Phase 3 publisher-move ships. We filter
  // out club rows at render time below.
  key: 'free' | 'club' | 'blackbook';
  label: string;
  blurb: string;
  first_date: string | null;
  last_date: string | null;
  n_days: number;
  headline: Summary;
  headline_30d: Summary;
  by_code: CodeBlock[];
  winners?: Pick[];
}

interface Ledger {
  generated_at: string;
  first_date: string | null;
  last_date: string | null;
  window_30d_first: string | null;
  window_30d_last: string | null;
  tiers: Tier[];
}

const ledger = ledgerData as Ledger;
const visibleTiers = ledger.tiers.filter(t => t.key !== 'club');
const freeTier = ledger.tiers.find(t => t.key === 'free')!;

function fmtDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', timeZone: 'UTC' });
}

function fmtSign(n: number): string {
  return (n >= 0 ? '+' : '') + n.toFixed(2);
}

function fmtPct(n: number | null): string {
  if (n === null) return '—';
  return (n >= 0 ? '+' : '') + n.toFixed(1) + '%';
}
---

<BaseLayout
  title="Ledger — Blackbook Racing"
  description="Public performance ledger across Free and Blackbook tiers. Aggregate ROI, strike rate, and per-race-code breakdown reconciled to Betfair Starting Price."
>
  <article class="page">
    <p class="eyebrow">Public ledger</p>
    <h1 class="page-title">The ledger.</h1>
    <p class="lede">
      Headline performance across Free and Blackbook tiers, broken down by race code and
      signal. Every selection timestamped pre-off. Every result reconciled to Betfair Starting
      Price after the race. Full pick-by-pick audit trail (winners and losers) lives in the
      members area.
    </p>

    <section class="tier-band">
      <p class="tier-band-eyebrow">Live performance by tier</p>
      <div class="tier-grid">
        {visibleTiers.map(t => (
          <article class={"tier-card tier-card-" + t.key + (t.key === 'blackbook' ? ' tier-card-accent' : '')}>
            <header class="tier-head">
              <h2 class="tier-label">{t.label}</h2>
              <span class="tier-pill">
                {t.key === 'free' ? '£0' : '£39.99/mo'}
              </span>
            </header>
            <p class="tier-blurb">{t.blurb}</p>
            <div class="tier-headline">
              <div class="tier-roi">
                <span class={"tier-roi-value " + ((t.headline.roi_pct ?? 0) >= 0 ? "pos" : "neg")}>
                  {fmtPct(t.headline.roi_pct)}
                </span>
                <span class="tier-roi-label">ROI</span>
              </div>
              <div class="tier-mini-row">
                <div class="tier-mini">
                  <span class="tier-mini-value">{t.headline.n_picks}</span>
                  <span class="tier-mini-label">Selections</span>
                </div>
                <div class="tier-mini">
                  <span class="tier-mini-value">{t.headline.hit_rate_pct?.toFixed(1) ?? '—'}%</span>
                  <span class="tier-mini-label">Strike rate</span>
                </div>
                <div class="tier-mini">
                  <span class="tier-mini-value">{t.n_days}</span>
                  <span class="tier-mini-label">Race days</span>
                </div>
              </div>
            </div>
            {t.key === 'free' && t.headline.n_picks < 80 && (
              <p class="tier-caveat">
                Small-sample cohort by design — the Free tier surfaces just one top-conviction
                selection per race day. Treat the headline ROI as directional, not predictive.
              </p>
            )}
            <div class="tier-breakdown">
              <p class="tier-breakdown-label">Breakdown by race code &amp; signal</p>
              <table class="breakdown-table">
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Signal</th>
                    <th class="num">Picks</th>
                    <th class="num">Hit</th>
                    <th class="num">ROI</th>
                  </tr>
                </thead>
                <tbody>
                  {t.by_code.map(c => (
                    <>
                      {c.banks.map((b, i) => (
                        <tr class={"bank-row " + (i === 0 ? "bank-row-first" : "")}>
                          {i === 0 ? (
                            <td class="code-cell" rowspan={c.banks.length}>
                              <span class="code-label">{c.label}</span>
                              <span class="code-abbr">{c.race_code}</span>
                            </td>
                          ) : null}
                          <td class="bank-cell">{b.bank_label}</td>
                          <td class="num">{b.n_picks}</td>
                          <td class="num">{b.hit_rate_pct?.toFixed(1) ?? '—'}%</td>
                          <td class={"num " + ((b.roi_pct ?? 0) >= 0 ? "pos" : "neg")}>{fmtPct(b.roi_pct)}</td>
                        </tr>
                      ))}
                    </>
                  ))}
                </tbody>
              </table>
            </div>
          </article>
        ))}
      </div>
      <p class="period">
        {ledger.first_date && fmtDate(ledger.first_date)} <span class="dash">—</span>{' '}
        {ledger.last_date && fmtDate(ledger.last_date)} <span class="dot">▲</span> {freeTier.n_days} race days
      </p>
    </section>

    <section class="block">
      <h2>Free tier — winning selections</h2>
      <p class="block-note">
        Every winning selection from the Free tier — one top-conviction pick each race day, in
        reverse-chronological order. The full audit trail across every tier (winners and losers,
        with prices, timestamps and reasoning) lives in the <a href="/subscribe">members area</a>.
      </p>
      <table class="data-table picks-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Off</th>
            <th>Course</th>
            <th>Horse</th>
            <th class="num">BSP</th>
            <th class="num">P&amp;L</th>
          </tr>
        </thead>
        <tbody>
          {(freeTier.winners ?? []).map(p => (
            <tr>
              <td>{fmtDate(p.date)}</td>
              <td>{p.race_time}</td>
              <td>{p.course}</td>
              <td class="horse">{p.horse}</td>
              <td class="num">{p.bsp !== null ? p.bsp.toFixed(2) : '—'}</td>
              <td class={"num " + (p.profit_pts >= 0 ? "pos" : "neg")}>{fmtSign(p.profit_pts)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <p class="note">
      Stakes are 1pt unit; ROI is profit on stake. BSP is Betfair Starting Price; profit assumes 2% Betfair commission on winning bets.
    </p>
    <p class="note generated">
      Generated {ledger.generated_at}.
    </p>
  </article>

  <style>
    .page {
      padding-top: 16px;
    }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      text-align: center;
      margin-bottom: 12px;
    }

    .page-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 700;
      font-size: 40px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 24px;
    }

    .lede {
      font-family: 'EB Garamond', serif;
      font-size: 19px;
      line-height: 1.55;
      color: var(--ink-soft);
      max-width: 640px;
      margin: 0 auto 56px;
      text-align: center;
    }

    /* === Tier band === */
    .tier-band {
      max-width: 1180px;
      margin: 0 auto 56px;
    }

    .tier-band-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      text-align: center;
      margin-bottom: 24px;
    }

    .tier-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      max-width: 760px;
      margin: 0 auto;
    }

    .tier-card {
      padding: 28px 24px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--cream);
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .tier-card-accent {
      border-color: var(--gold);
      box-shadow: inset 0 0 0 1px var(--gold), 0 8px 24px -16px rgba(193, 164, 103, 0.45);
      background: linear-gradient(180deg, var(--cream) 0%, rgba(193, 164, 103, 0.08) 100%);
    }

    .tier-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--rule);
    }

    .tier-label {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0;
    }

    .tier-pill {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.22em;
      color: var(--gold);
      font-weight: 700;
      text-transform: uppercase;
    }

    .tier-blurb {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
      line-height: 1.45;
      color: var(--ink-soft);
      min-height: 70px;
    }

    .tier-headline {
      display: flex;
      flex-direction: column;
      gap: 16px;
      font-feature-settings: 'tnum';
    }

    .tier-roi {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--rule);
    }

    .tier-roi-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 38px;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1;
    }

    .tier-roi-label {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 600;
    }

    .tier-mini-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .tier-mini {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .tier-mini-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1;
    }

    .tier-mini-label {
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 600;
    }

    .pos { color: #2d5a2d; }
    .neg { color: #8b2a2a; }

    .tier-caveat {
      font-family: 'EB Garamond', serif;
      font-size: 14px;
      font-style: italic;
      line-height: 1.5;
      color: var(--ink-mute);
      padding: 12px 14px;
      border-left: 2px solid var(--gold);
      background: rgba(193, 164, 103, 0.08);
    }

    .tier-breakdown {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: auto;
    }

    .tier-breakdown-label {
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 600;
    }

    .breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-feature-settings: 'tnum';
    }

    .breakdown-table th {
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--ink-mute);
      text-align: left;
      padding: 8px 6px;
      border-bottom: 1px solid var(--ink);
    }

    .breakdown-table th.num {
      text-align: right;
    }

    .breakdown-table td {
      padding: 8px 6px;
      border-bottom: 1px solid var(--rule);
      vertical-align: middle;
    }

    .breakdown-table td.num {
      text-align: right;
    }

    .breakdown-table .code-cell {
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      font-weight: 600;
      border-right: 1px solid var(--rule);
      padding-right: 10px;
      vertical-align: middle;
    }

    .breakdown-table .code-cell .code-label {
      display: block;
      letter-spacing: 0.04em;
    }

    .breakdown-table .code-cell .code-abbr {
      display: block;
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      letter-spacing: 0.18em;
      color: var(--gold);
      font-weight: 700;
      margin-top: 2px;
    }

    .breakdown-table .bank-cell {
      font-family: 'EB Garamond', serif;
      font-size: 14px;
      color: var(--ink-soft);
    }

    .period {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.06em;
      color: var(--ink-mute);
      text-align: center;
      margin: 28px 0 4px;
      font-feature-settings: 'tnum';
    }

    .period .dash {
      margin: 0 6px;
    }

    .period .dot {
      color: var(--gold);
      margin: 0 8px;
    }

    .block {
      max-width: 920px;
      margin: 0 auto;
      padding-bottom: 36px;
    }

    .block + .block {
      padding-top: 36px;
      border-top: 1px solid var(--rule);
    }

    .block h2 {
      font-size: 20px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .block-note {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
      line-height: 1.55;
      color: var(--ink-soft);
      max-width: 720px;
      margin-bottom: 22px;
    }

    .block-note a {
      color: var(--ink);
      border-bottom: 1px solid var(--gold);
    }

    /* === Course table === */
    .course-table .course-name {
      font-family: 'EB Garamond', serif;
      font-size: 15px;
    }

    .row-neg .course-name {
      color: var(--ink-soft);
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-feature-settings: 'tnum';
    }

    .data-table th {
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--ink-mute);
      text-align: left;
      padding: 10px 12px;
      border-bottom: 1px solid var(--ink);
    }

    .data-table th.num {
      text-align: right;
    }

    .data-table td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--rule);
      vertical-align: baseline;
    }

    .data-table td.num {
      text-align: right;
    }

    .picks-table .horse {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
    }

    .note {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--ink-mute);
      text-align: center;
      max-width: 600px;
      margin: 16px auto 0;
      line-height: 1.55;
    }

    .note.generated {
      margin-top: 8px;
      opacity: 0.7;
      font-feature-settings: 'tnum';
    }

    @media (max-width: 1080px) {
      .tier-grid {
        grid-template-columns: 1fr;
        gap: 16px;
        max-width: 560px;
        margin: 0 auto;
      }
    }

    @media (max-width: 720px) {
      .page-title {
        font-size: 28px;
      }

      .lede {
        font-size: 17px;
        margin-bottom: 40px;
      }

      .tier-card {
        padding: 24px 22px;
      }

      .tier-roi-value {
        font-size: 32px;
      }

      .tier-mini-value {
        font-size: 18px;
      }

      .data-table {
        font-size: 12px;
      }

      .data-table th,
      .data-table td {
        padding: 8px 6px;
      }

      .picks-table .horse {
        font-size: 14px;
      }
    }
  </style>
</BaseLayout>
