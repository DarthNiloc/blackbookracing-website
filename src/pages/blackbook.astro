---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Blackbook — Blackbook Racing Club"
  description="The seasonal Blackbook of horses worth tracking — Blackbook-tier members only."
>
  <article class="page">
    <p class="eyebrow">Members area</p>
    <h1 class="page-title">The Blackbook</h1>
    <div class="stub-card">
      <p class="stub-lede">
        The Blackbook is the seasonal list of horses we've flagged across multiple runs and expect
        to fire when conditions align. Each entry has a reason and a target run window.
      </p>
      <p class="stub-lede stub-lede-secondary">
        Blackbook-tier members only. Paid signup opens at launch.
      </p>
      <div class="stub-ctas">
        <a class="cta cta-primary" href="/subscribe">View Blackbook tier</a>
        <a class="cta" href="/members">See a sample entry</a>
      </div>
    </div>
  </article>

  <style>
    .page {
      padding-top: 16px;
      max-width: 640px;
      margin: 0 auto;
    }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
      text-align: center;
      margin-bottom: 12px;
    }

    .page-title {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 700;
      font-size: 40px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 40px;
    }

    .stub-card {
      border: 1px solid var(--gold);
      box-shadow: inset 0 0 0 1px var(--gold);
      border-radius: 4px;
      padding: 40px 36px;
      background: var(--cream);
      text-align: center;
    }

    .stub-lede {
      font-family: 'EB Garamond', serif;
      font-size: 19px;
      line-height: 1.55;
      color: var(--ink);
      margin-bottom: 20px;
    }

    .stub-lede-secondary {
      font-size: 16px;
      color: var(--ink-soft);
      font-style: italic;
      margin-bottom: 32px;
    }

    .stub-ctas {
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .cta {
      display: inline-block;
      padding: 12px 22px;
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      text-decoration: none;
      border-radius: 4px;
      border: 1px solid var(--ink);
      color: var(--ink);
      background: var(--cream);
    }

    .cta-primary {
      background: var(--ink);
      color: var(--cream);
    }

    @media (max-width: 640px) {
      .page-title {
        font-size: 28px;
      }

      .stub-card {
        padding: 32px 22px;
      }

      .stub-lede {
        font-size: 17px;
      }
    }
  </style>
</BaseLayout>
