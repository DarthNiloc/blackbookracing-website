---
interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const DEFAULT_DESCRIPTION = "Pre-off selections. Public ledger. UK flat racing — turf and all-weather, with a hurdle add-on for Blackbook members.";

const { title, description = DEFAULT_DESCRIPTION, ogType = 'website' } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));

// Canonical URL: always points to production domain regardless of where the
// page is currently served. Astro.site is set in astro.config.mjs.
const canonicalUrl = new URL(pathname, Astro.site).href;
const ogImage = new URL('/logo.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Pre-launch: noindex everywhere until DNS cuts over to blackbookracing.com.
         Once the production domain is live, swap this to `index, follow`. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=EB+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Blackbook Racing" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Blackbook Racing — home">
          <img src="/logo.png" alt="Blackbook Racing" />
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" class={isActive('/') ? 'is-active' : ''}>Home</a>
          <a href="/how-we-work" class={isActive('/how-we-work') ? 'is-active' : ''}>How we work</a>
          <a href="/ledger" class={isActive('/ledger') ? 'is-active' : ''}>Ledger</a>
          <a href="/systems" class={isActive('/systems') ? 'is-active' : ''}>Systems</a>
          <a href="/stats" class={isActive('/stats') ? 'is-active' : ''}>Stats</a>
          <a href="/articles" class={isActive('/articles') ? 'is-active' : ''}>Articles</a>
          <a href="/sample" class={isActive('/sample') ? 'is-active' : ''}>Sample</a>
          <a href="/subscribe" class={isActive('/subscribe') ? 'is-active' : ''}>Subscribe</a>
          <span class="nav-sep" aria-hidden="true"></span>
          <a href="/login" class={"nav-utility " + (isActive('/login') ? 'is-active' : '')}>Login</a>
          <a href="/blackbook" class={"nav-utility " + (isActive('/blackbook') ? 'is-active' : '')}>Blackbook</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-disclaimer">
          Information service only. We don't pool funds, accept stakes, or operate as a syndicate.
          Selections are published pre-off; you place your own bets at your own broker, at your own
          risk. Past performance does not guarantee future returns.
        </p>
        <p class="footer-respo">
          <span class="age">18+</span><span class="dot">▲</span>
          <a href="https://www.begambleaware.org" rel="noopener" target="_blank">BeGambleAware</a><span class="dot">▲</span>
          Bet responsibly. National Gambling Helpline: <span class="hl">0808 8020 133</span>.
        </p>
        <p class="footer-copy">© Blackbook Racing</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --ink: #0A0A0A;
        --cream: #F5F1E8;
        --gold: #C1A467;
        --ink-soft: rgba(10, 10, 10, 0.7);
        --ink-mute: rgba(10, 10, 10, 0.55);
        --rule: rgba(10, 10, 10, 0.12);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: var(--cream);
      }

      body {
        background: var(--cream);
        color: var(--ink);
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 18px;
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1 0 auto;
        width: 100%;
        max-width: 980px;
        margin: 0 auto;
        padding: 64px 40px;
      }

      h1, h2, h3 {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 700;
        color: var(--ink);
      }

      a {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--gold);
        text-underline-offset: 4px;
        text-decoration-thickness: 1px;
      }

      a:hover {
        text-decoration-thickness: 2px;
      }

      .site-header {
        border-bottom: 1px solid var(--rule);
        background: var(--cream);
      }

      .header-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 20px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        line-height: 0;
      }

      .brand img {
        height: 56px;
        width: auto;
        display: block;
      }

      .site-nav {
        display: flex;
        gap: 22px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .site-nav a {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        font-weight: 500;
        padding-bottom: 4px;
        border-bottom: 1px solid transparent;
        white-space: nowrap;
      }

      .site-nav a:hover {
        border-bottom-color: var(--gold);
      }

      .site-nav a.is-active {
        border-bottom-color: var(--gold);
        color: var(--ink);
      }

      .site-nav .nav-sep {
        display: inline-block;
        width: 1px;
        height: 14px;
        background: var(--rule);
        margin: 0 4px;
      }

      .site-nav a.nav-utility {
        color: var(--ink-mute);
      }

      .site-nav a.nav-utility:hover,
      .site-nav a.nav-utility.is-active {
        color: var(--ink);
        border-bottom-color: var(--gold);
      }

      .site-footer {
        flex: 0 0 auto;
        border-top: 1px solid var(--rule);
        background: var(--cream);
        margin-top: 64px;
      }

      .footer-inner {
        max-width: 980px;
        margin: 0 auto;
        padding: 32px 40px 40px;
        text-align: center;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--ink-mute);
      }

      .footer-inner p + p {
        margin-top: 10px;
      }

      .footer-inner .dot {
        color: var(--gold);
        margin: 0 6px;
      }

      .footer-disclaimer {
        font-family: 'EB Garamond', serif;
        font-size: 13px;
        line-height: 1.55;
        color: var(--ink-soft);
        letter-spacing: 0;
        max-width: 680px;
        margin: 0 auto;
      }

      .footer-respo {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--ink);
      }

      .footer-respo .age {
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .footer-respo .hl {
        font-feature-settings: 'tnum';
        font-weight: 600;
      }

      .footer-respo a {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--gold);
        text-underline-offset: 3px;
      }

      .footer-copy {
        font-family: 'Inter', sans-serif;
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-top: 18px !important;
      }

      @media (max-width: 640px) {
        .header-inner {
          padding: 16px 22px;
          gap: 16px;
          flex-wrap: wrap;
        }

        .brand img {
          height: 44px;
        }

        .site-nav {
          gap: 18px;
        }

        .site-nav a {
          font-size: 11px;
          letter-spacing: 0.14em;
        }

        .site-nav .nav-sep {
          display: none;
        }

        main {
          padding: 40px 22px;
        }

        .footer-inner {
          padding: 28px 22px 32px;
        }
      }
    </style>
  </body>
</html>
